class SistemaImplementacaoCodigo:
    """Sistema para implementar e integrar código corrigido das IAs"""
    
    def __init__(self):
        self.historico_implementacoes = []
        self.analise_diferencas = []
        self.erros_implementacao = []
    
    def implementar_correcao_ia(self, codigo_original: str, correcao_ia: Dict[str, Any], tipo_ia: str) -> Dict[str, Any]:
        """Implementa correção sugerida por IA no código original"""
        try:
            # Extrair código corrigido da resposta da IA
            codigo_corrigido = self._extrair_codigo_corrigido(correcao_ia, tipo_ia)
            
            if not codigo_corrigido:
                return {
                    'sucesso': False,
                    'erro': 'Não foi possível extrair código corrigido da resposta da IA',
                    'codigo_implementado': codigo_original
                }
            
            # Analisar diferenças
            diferencas = self._analisar_diferencas(codigo_original, codigo_corrigido)
            
            # Aplicar correção
            codigo_implementado = self._aplicar_correcao(codigo_original, codigo_corrigido, diferencas)
            
            # Validar implementação
            validacao = self._validar_implementacao(codigo_original, codigo_implementado)
            
            resultado = {
                'sucesso': validacao['valido'],
                'codigo_implementado': codigo_implementado,
                'diferencas_detectadas': diferencas,
                'validacao': validacao,
                'tipo_ia': tipo_ia,
                'timestamp': datetime.now().isoformat()
            }
            
            self.historico_implementacoes.append(resultado)
            return resultado
            
        except Exception as e:
            erro = {
                'sucesso': False,
                'erro': str(e),
                'codigo_implementado': codigo_original,
                'timestamp': datetime.now().isoformat()
            }
            self.erros_implementacao.append(erro)
            return erro
    
    def _extrair_codigo_corrigido(self, correcao_ia: Dict[str, Any], tipo_ia: str) -> str:
        """Extrai código corrigido da resposta da IA baseado no tipo"""
        resposta = correcao_ia.get('resposta', '')
        
        # Padrões para extração de código
        padroes_codigo = [
            r'```python\s*(.*?)\s*```',  # Blocos de código Python
            r'```\s*(.*?)\s*```',        # Blocos de código genéricos
            r'def\s+\w+.*?(?=\n\s*def|\n\s*class|\n*$)',  # Funções individuais
            r'class\s+\w+.*?(?=\n\s*class|\n*$)',         # Classes individuais
        ]
        
        for padrao in padroes_codigo:
            matches = re.findall(padrao, resposta, re.DOTALL)
            if matches:
                # Retornar o maior bloco de código encontrado
                return max(matches, key=len)
        
        # Se não encontrou blocos de código, tentar extrair linhas relevantes
        linhas = resposta.split('\n')
        linhas_codigo = [linha for linha in linhas if any(palavra in linha for palavra in 
                        ['def ', 'class ', 'import ', 'from ', 'return ', 'if ', 'for ', 'while '])]
        
        return '\n'.join(linhas_codigo) if linhas_codigo else ''
    
    def _analisar_diferencas(self, original: str, corrigido: str) -> Dict[str, Any]:
        """Analisa diferenças entre código original e corrigido"""
        linhas_original = original.split('\n')
        linhas_corrigido = corrigido.split('\n')
        
        # Análise básica de diferenças
        diferencas = {
            'adicoes': [],
            'remocoes': [],
            'modificacoes': [],
            'estruturas_afetadas': self._identificar_estruturas_afetadas(original, corrigido),
            'metricas_alteradas': self._calcular_metricas_alteradas(original, corrigido)
        }
        
        # Análise linha por linha (simplificada)
        for i, (linha_orig, linha_corr) in enumerate(zip(linhas_original, linhas_corrigido)):
            if linha_orig != linha_corr:
                if linha_orig.strip() and not linha_corr.strip():
                    diferencas['remocoes'].append({'linha': i+1, 'conteudo': linha_orig})
                elif not linha_orig.strip() and linha_corr.strip():
                    diferencas['adicoes'].append({'linha': i+1, 'conteudo': linha_corr})
                else:
                    diferencas['modificacoes'].append({
                        'linha': i+1,
                        'original': linha_orig,
                        'corrigido': linha_corr
                    })
        
        return diferencas
    
    def _identificar_estruturas_afetadas(self, original: str, corrigido: str) -> List[str]:
        """Identifica estruturas de código que foram modificadas"""
        estruturas = []
        
        # Funções modificadas
        funcoes_orig = set(re.findall(r'def\s+(\w+)', original))
        funcoes_corr = set(re.findall(r'def\s+(\w+)', corrigido))
        
        if funcoes_orig != funcoes_corr:
            estruturas.append('Funções')
        
        # Classes modificadas
        classes_orig = set(re.findall(r'class\s+(\w+)', original))
        classes_corr = set(re.findall(r'class\s+(\w+)', corrigido))
        
        if classes_orig != classes_corr:
            estruturas.append('Classes')
        
        # Imports modificados
        imports_orig = set(re.findall(r'import\s+([^\n]+)', original))
        imports_corr = set(re.findall(r'import\s+([^\n]+)', corrigido))
        
        if imports_orig != imports_corr:
            estruturas.append('Imports')
        
        return estruturas
    
    def _calcular_metricas_alteradas(self, original: str, corrigido: str) -> Dict[str, Any]:
        """Calcula métricas alteradas entre as versões"""
        executor = SistemaExecucaoCodigo()
        
        analise_orig = executor._analisar_codigo_pre_execucao(original)
        analise_corr = executor._analisar_codigo_pre_execucao(corrigido)
        
        return {
            'complexidade_antes': analise_orig['complexidade_ciclomatica'],
            'complexidade_depois': analise_corr['complexidade_ciclomatica'],
            'funcoes_antes': analise_orig['numero_funcoes'],
            'funcoes_depois': analise_corr['numero_funcoes'],
            'classes_antes': analise_orig['numero_classes'],
            'classes_depois': analise_corr['numero_classes'],
            'linhas_antes': analise_orig['linhas_codigo'],
            'linhas_depois': analise_corr['linhas_codigo']
        }
    
 
